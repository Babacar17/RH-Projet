<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- Spring ContextLoaderListener -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>/WEB-INF/spring-config.xml</param-value>
    </context-param>

    <!-- JSF Servlet -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>41943040</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>Principal/index.xhtml</welcome-file>
    </welcome-file-list>

    <!-- FORCER les sessions par COOKIE uniquement (pas d'URL rewriting) -->
    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Vue expirée → login -->
    <error-page>
        <exception-type>jakarta.faces.application.ViewExpiredException</exception-type>
        <location>/Authentification/login.xhtml</location>
    </error-page>

    <!-- SUPPRIMER la redirection 500 vers login — elle masquait les vraies erreurs -->
    <!-- error-page>
        <error-code>500</error-code>
        <location>/Authentification/login.xhtml</location>
    </error-page -->

    <!-- JSF state côté serveur -->
    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <!-- Nombre de vues en session — augmenté pour éviter les ViewExpiredException
         (dashboards riches + dialogs PrimeFaces saturent vite la limite par défaut) -->
    <context-param>
        <param-name>org.apache.myfaces.NUMBER_OF_VIEWS_IN_SESSION</param-name>
        <param-value>50</param-value>
    </context-param>

    <!-- Nombre de vues séquentielles par session — pour les workflows à dialogs multiples -->
    <context-param>
        <param-name>org.apache.myfaces.NUMBER_OF_SEQUENTIAL_VIEWS_IN_SESSION</param-name>
        <param-value>8</param-value>
    </context-param>

    <!-- Ne pas mettre en cache les vieilles vues, libère la mémoire plus vite -->
    <context-param>
        <param-name>org.apache.myfaces.SERIALIZE_STATE_IN_SESSION</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- ═══════════════════════════════════════════════════════════════
         FORCER LE RECHARGEMENT DES TEMPLATES FACELETS (développement)
         Valeur 0 = recompile à chaque requête (détecte les modifs XHTML)
         Mettre -1 en production pour la performance
    ═══════════════════════════════════════════════════════════════ -->
    <context-param>
        <param-name>jakarta.faces.FACELETS_REFRESH_PERIOD</param-name>
        <param-value>0</param-value>
    </context-param>

    <!-- Désactiver l'URL rewriting de session (empêche jsessionid dans les URLs) -->
    <context-param>
        <param-name>org.apache.myfaces.DISABLE_REDIRECT_FOR_EXPIRED_VIEWS</param-name>
        <param-value>false</param-value>
    </context-param>

</web-app>