<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.soutenance</groupId>
    <artifactId>soutenance</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.version>6.1.6</spring.version>
        <hibernate.version>6.2.7.Final</hibernate.version>
        <primefaces.version>14.0.0</primefaces.version>
    </properties>

    <dependencies>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Jakarta EE 10 — fourni par TomEE (scope provided) -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- PrimeFaces 14 — classifier jakarta obligatoire    -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>${primefaces.version}</version>
            <classifier>jakarta</classifier>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Hibernate ORM 6                                    -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- PostgreSQL Driver                                  -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Spring Framework 6.1.6                            -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Spring Security Crypto — BCrypt uniquement        -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>6.2.3</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Logging — SLF4J → java.util.logging (TomEE)       -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.9</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Apache POI — Excel/Word                           -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- iText 5 — génération PDF (ContratService)         -->
        <!-- ══════════════════════════════════════════════════ -->
        <!-- NOTE : OpenPDF (com.lowagie) retiré car PrimeFaces -->
        <!-- 14 requiert OpenPDF 2.x mais son API est           -->
        <!-- incompatible avec iText 5 présent dans ce projet. -->
        <!-- Les exports PDF p:dataExporter ont été remplacés   -->
        <!-- par des exports Excel (Apache POI, déjà présent). -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itext-asian</artifactId>
            <version>5.2.0</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- JSON                                               -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Jakarta Mail — implémentation Angus Mail          -->
        <!-- (jakarta.mail-api est fourni par jakartaee-api,    -->
        <!--  mais TomEE Web ne livre pas l'implémentation)    -->
        <!-- ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>2.0.3</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>Soutenance</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>